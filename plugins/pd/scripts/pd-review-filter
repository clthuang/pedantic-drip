#!/usr/bin/env python3
"""pd-review-filter: drop a scoped re-review's new findings outside the diff's hunks (plan §A4, D15).

  pd-review-filter (--diff <file> | --range <A..B>) [<review.json>]    # the review from the file, or stdin
  pd-review-filter --self-test
Prints the review JSON with `new_in_diff` cut to the findings whose file:line lies inside a hunk of
the diff's new side, and names each dropped finding on stderr. Schema: references/workflow-results.md.
"""
import argparse, json, re, subprocess, sys, tempfile  # noqa: E401
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from pd_common import Checks  # noqa: E402

HUNK_RE = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")


def new_side(diff):
    """{path: [(first, last)]}: each hunk's new-side lines; a pure deletion covers the two lines beside it."""
    spans, path, prev = {}, None, ""
    for line in diff.split("\n"):
        if line.startswith("+++ ") and prev.startswith("--- "):  # a header, not an added line "++ …"
            name = line[4:].split("\t")[0]
            path = None if name == "/dev/null" else name[2:] if name.startswith("b/") else name
        elif path and (m := HUNK_RE.match(line)):
            start, count = int(m.group(1)), int(m.group(2) or 1)
            spans.setdefault(path, []).append((start, start + count - 1) if count else (start, start + 1))
        prev = line
    return spans


def inside(issue, spans):
    line = str(issue.get("line"))
    return line.isdigit() and any(a <= int(line) <= b for a, b in spans.get(issue.get("file"), ()))


def filter_review(review, diff):
    spans, new = new_side(diff), review.get("new_in_diff", [])
    return dict(review, new_in_diff=[i for i in new if inside(i, spans)]), [i for i in new if not inside(i, spans)]


def main(argv):
    ap = argparse.ArgumentParser(prog="pd-review-filter", description=__doc__.split("\n")[0])
    ap.add_argument("review", nargs="?")
    ap.add_argument("--diff")
    ap.add_argument("--range")
    ap.add_argument("--self-test", action="store_true")
    a = ap.parse_args(argv)
    if a.self_test:
        return self_test()
    if bool(a.diff) == bool(a.range):
        ap.error("give one of --diff <file> or --range <A..B>")
    diff = Path(a.diff).read_text() if a.diff else \
        subprocess.run(["git", "diff", a.range], capture_output=True, text=True, check=True).stdout
    out, dropped = filter_review(json.loads(Path(a.review).read_text() if a.review else sys.stdin.read()), diff)
    for i in dropped:
        print(f"pd-review-filter: dropped {i.get('id')} {i.get('file')}:{i.get('line')}, outside the diff", file=sys.stderr)
    print(json.dumps(out, indent=2))
    return 0


DIFF = ("diff --git a/src/a.py b/src/a.py\n--- a/src/a.py\n+++ b/src/a.py\n@@ -10,2 +10,3 @@ def f():\n x = 1\n+y = 2\n"
        " z = 3\n@@ -40,2 +40,0 @@\n-gone = 1\n-gone = 2\ndiff --git a/src/old.py b/src/old.py\ndeleted file mode 100644\n--- a/src/old.py\n"
        "+++ /dev/null\n@@ -1 +0,0 @@\n-x = 1\ndiff --git a/src/b.py b/src/b.py\n--- a/src/b.py\n+++ b/src/b.py\n@@ -1,0 +1,2 @@\n"
        "+++ b/src/fake.py\n+w = 1\n@@ -5,0 +7 @@\n+v = 2\n")


def self_test():
    c = Checks("pd-review-filter")
    cases = {"K1": ("src/a.py", 11), "K2": ("src/a.py", 12), "D1": ("src/a.py", 13), "D2": ("src/a.py", 30),
             "K3": ("src/a.py", 40), "D3": ("src/a.py", 42), "D4": ("src/old.py", 1), "K4": ("src/b.py", 2),
             "D5": ("src/fake.py", 7), "D6": ("src/a.py", None), "K5": ("src/b.py", 7)}
    review = {"findings": [{"id": "R1", "status": "resolved", "evidence": "x"}],
              "new_in_diff": [{"id": k, "file": f, "line": n} for k, (f, n) in cases.items()]}
    out, dropped = filter_review(review, DIFF)
    c.check([i["id"] for i in out["new_in_diff"]] == ["K1", "K2", "K3", "K4", "K5"], "kept exactly the in-hunk findings")
    c.check(sorted(i["id"] for i in dropped) == ["D1", "D2", "D3", "D4", "D5", "D6"], "dropped the rest, edges included")
    c.check(out["findings"] == review["findings"], "the status findings pass through untouched")
    with tempfile.TemporaryDirectory() as tmp:
        (Path(tmp) / "d.diff").write_text(DIFF)
        r = subprocess.run([sys.executable, __file__, "--diff", str(Path(tmp) / "d.diff")], input=json.dumps(review),
                           capture_output=True, text=True)
        c.check(r.returncode == 0 and [i["id"] for i in json.loads(r.stdout)["new_in_diff"]] == ["K1", "K2", "K3", "K4", "K5"]
                and "dropped D2 src/a.py:30" in r.stderr, "the CLI filters stdin and names each drop on stderr")
    return c.done()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
