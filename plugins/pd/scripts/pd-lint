def run_case(base, tmp, i, case):
    label, mutate, args, kind, needle = case
    r = Path(tmp) / f"c{i}"
    shutil.copytree(base, r, symlinks=True)
    try:
        mutate(r)
    except AssertionError as e:
        return label, False, f"fixture did not apply: {e}"
    p = subprocess.run([sys.executable, str(Path(__file__).resolve()), *args], cwd=r, capture_output=True, text=True)
    out = p.stdout + p.stderr
    errs = [l for l in out.splitlines() if " ERROR " in l]
    warns = [l for l in out.splitlines() if " WARN " in l]
    ok = {"ok": p.returncode == 0 and not errs,
          "error": p.returncode == 1 and any(needle in l for l in errs),
          "warn": p.returncode == 0 and not errs and any(needle in l for l in warns),
          "nowarn": p.returncode == 0 and not errs and not any(needle in l for l in warns)}[kind]
    return label, ok, out


def self_test():
    c = pc.Checks("pd-lint")
    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp) / "base"
        code = build_base(base)
        with ThreadPoolExecutor(8) as pool:
            results = list(pool.map(lambda ic: run_case(base, tmp, *ic), enumerate(cases(code))))
        for label, ok, out in results:
            c.check(ok, label)
            if not ok:
                print("  " + out.strip().replace("\n", "\n  ")[:1500])
        # --archive moves ticked lines; --sweep lists, by item status, and deletes nothing.
        r = Path(tmp) / "archive"
        shutil.copytree(base, r, symlinks=True)
        subprocess.run([sys.executable, str(Path(__file__).resolve()), "--archive"], cwd=r, capture_output=True)
        c.check("2026-10-10-parse-input" in (r / ART / "backlog-archive.md").read_text()
                and "[x]" not in (r / BL).read_text(), "--archive moves ticked lines")
        for d in ("2020-01-01/parse-input", "2020-01-01/mystery", f"{date.today()}/parse-input"):
            (r / "agent_sandbox" / d).mkdir(parents=True)
        out = subprocess.run([sys.executable, str(Path(__file__).resolve()), "--sweep"], cwd=r,
                             capture_output=True, text=True).stdout
        done_part, other_part = out.split("no done item")
        c.check("2020-01-01/parse-input" in done_part and "mystery" in other_part and str(date.today()) not in out
                and (r / "agent_sandbox" / "2020-01-01" / "mystery").is_dir(), "--sweep lists by item status, deletes nothing")
        u = pc.make_repo(Path(tmp) / "unadopted")
        (u / "docs" / "features").mkdir(parents=True)
        out = subprocess.run([sys.executable, str(Path(__file__).resolve())], cwd=u, capture_output=True, text=True)
        c.check(out.returncode == 0 and "not adopted: run /pd:adopt" in out.stdout, "an unadopted project is told to adopt")
    return c.done()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception:  # a crash exits 3, not 1, so the commit hook reports it instead of blocking the commit
        import traceback
        traceback.print_exc()
        sys.exit(3)
