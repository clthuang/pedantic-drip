---
config:
  theme: base
  themeVariables:
    fontSize: 15px
    lineColor: "#555"
  flowchart:
    nodeSpacing: 40
    rankSpacing: 48
    htmlLabels: true
    wrappingWidth: 420
---
flowchart TD

  %% The canonical pd workflow on Claude Code's native features.
  %% Source of truth: the stage skills, plugins/pd/skills/<name>/SKILL.md (brainstorming,
  %% root-cause-analysis, specifying, designing, planning, implementing, verifying,
  %% finishing-branch, workflow-transitions). Triage: plugins/pd/commands/secretary.md.
  %% Gates: plugins/pd/scripts/phase-gate.sh. Fan-outs: plugins/pd/workflows/*.js.

  %% ===================== ENTRY =====================
  subgraph ENTRY ["Work arrives"]
    direction LR
    IDEA["<b>Idea</b><br/>no settled problem"]
    REQ["<b>Feature request</b><br/>intent stated, behaviour implicit"]
    BUG["<b>Bug</b><br/>something broke"]
  end

  TRI{{"<b>0 · Triage</b> · /pd:secretary<br/>picks the depth: <b>standard</b> · <b>small</b> (an estimate: ≤ small_feature_tasks tasks, default 3) · <b>express</b><br/>always standard for security, migrations, many files, areas new to the codebase,<br/>criteria hard to state as observable outcomes<br/>risk tags: security · migration"}}
  IDEA --> TRI
  REQ --> TRI
  BUG --> TRI

  %% ===================== SPINE =====================
  CLAR["<b>1 · Clarify</b> &nbsp; <i>a brainstorm or rca item</i><br/>is this the right problem? what would success look like?<br/>research-fanout only when it pays · rca-fanout for every bug<br/><i>kills: the wrong problem</i>"]
  TRI -- "idea · bug, cause unknown" --> CLAR

  CRIT["<b>2 · Criteria</b> &nbsp; <i>specify</i><br/>shape.md ## Requirements<br/>goals · non-goals · user stories<br/>behaviour expectations B1…Bn, each with an observable outcome<br/><i>kills: what counts as done</i>"]
  CLAR --> CRIT
  TRI -- "request · bug, cause known" --> CRIT

  G2{{"<b>gate</b> · phase-gate specify (exit)<br/>every expectation: id and observable outcome<br/>your sign-off recorded"}}
  R2{{"<b>calvin</b> · ≤ 3 review-revise cycles<br/>are the criteria faithful, and enough?<br/><b>you sign off the criteria</b>"}}
  CRIT --> R2 --> G2

  CON["<b>3 · Contracts</b> &nbsp; <i>design</i><br/>shape.md ## Design<br/><b>architecture diagram</b>: modules · flows · one contract per edge<br/>each contract pinned once · invariants<br/>test strategy: fixture locations · fakes · real resources allowed<br/>documents only: no code yet<br/><i>kills: what crosses each boundary</i>"]
  G2 --> CON

  R3{{"<b>design review</b> · Codex first · ≤ 3 review-revise cycles<br/>re-review checks only the earlier findings<br/>every edge has a contract, every contract an edge"}}
  G3{{"<b>gate</b> · phase-gate design (exit)<br/>diagram and test strategy present · no restated contract"}}
  CON --> R3 --> G3

  PLAN["<b>4 · Plan</b> &nbsp; <i>create-plan</i><br/>plan.md: tasks in waves · per task: contract · test cases · proving command · file set<br/>test cases in plain words or pseudo code, citing B-ids,<br/>naming their fixture, edges included<br/>from_shape: goes stale when shape.md moves<br/><i>kills: order, and what proves each step</i>"]
  G3 --> PLAN

  G4{{"<b>gate</b> · pd-lint, before the review<br/>every task: test cases, proving command, files<br/>every B-id covered · from_shape: still matches<br/>again at exit, with phase-gate create-plan"}}
  PLAN --> G4

  R4{{"<b>test-case review</b> · Codex first · ≤ 3 review-revise cycles<br/>faithful to the expectations? edges covered?"}}
  G4 --> R4

  %% ===================== EXECUTE =====================
  subgraph EXEC ["5 · Execute — implement-tasks workflow &nbsp; (kills: does the code meet each contract?)"]
    direction LR
    T1["task agent · sonnet · own worktree<br/>first commit: the tests + raising stubs<br/>(proof: green-only: tests may pass at once)<br/>then a commit per meaningful step"]
    T2["task agent · sonnet · own worktree<br/>first commit: the tests + raising stubs<br/>(proof: green-only: tests may pass at once)<br/>then a commit per meaningful step"]
    T3["sequential tasks · sonnet · own worktree<br/>one at a time, after the wave's parallel ones land<br/>same commit rules"]
    MRG["<b>merger</b><br/>per wave: the parallel tasks in plan order, then the sequential ones<br/>per task, pd-proof (reads the proving command's JUnit XML):<br/>first commit: no load or collection error,<br/>a test already green is named for Verify<br/>proof: green-only tasks skip the first-commit checks<br/>HEAD passes · tests untouched · fixtures in place<br/>after each merge: all merged proofs re-run<br/>an unexpected result is re-run once"]
    T1 --> MRG
    T2 --> MRG
    T3 --> MRG
  end
  R4 --> T1
  R4 --> T2
  R4 --> T3

  G5{{"<b>gate</b> · phase-gate implement (exit)<br/>every plan task on a run entry: merged, proof pass"}}
  MRG --> G5

  %% ===================== VERIFY =====================
  subgraph VER ["6 · Verify — verify-change workflow &nbsp; (kills: does the whole change hold together?)"]
    direction LR
    REV["<b>code review</b> · Codex first · one pass<br/>correctness, criteria, over-engineering<br/>each test asserts its case (case_map: each test case → its test)"]
    QA["<b>QA</b> · opus<br/>runs the suites, drives the flows<br/>hunts the cases no criterion named<br/>asks what each criterion still allows"]
    FIX["<b>fixer</b> · ≤ 3 cycles<br/>each cycle judged by re-running the checks<br/>each real finding: a failing test, then the fix<br/>a removal: delete the code<br/>the QA re-run checks red, then green"]
    REV -- "blockers" --> FIX
    QA -- "failing checks" --> FIX
  end
  G5 --> REV
  G5 --> QA

  G6{{"<b>gate</b> · phase-gate verify (exit)<br/>every qa_battery command passes in the latest QA run<br/>no source, test or fixture change since · no open blocker"}}
  FIX --> G6
  VER -- "clean: no blocker, every check green, zero fix cycles" --> G6

  FIN["<b>7 · Finish</b> &nbsp; <i>finish</i><br/>security review: always when tagged risk: security,<br/>else when the diff touches a security surface<br/>metrics entry in log.md · retro only on a trigger<br/>lessons become checks<br/><i>kills: what this taught</i>"]
  G6 --> FIN

  G7{{"<b>gate</b> · phase-gate finish<br/>retro.md present when log.md records a trigger:<br/>a second move back · a capped loop · a defect · tokens over budget"}}
  FIN --> G7
  SHIP([Ship])
  G7 -- "merge to the base branch" --> SHIP

  %% ===================== SHORTER PATHS =====================
  SMALL["<b>small</b>: Contracts and Plan<br/>written in one sitting<br/>one review call checks both<br/>exit: the design and plan gates<br/>a late risk tag: back to Contracts, at standard depth"]
  EXP["<b>express</b>: a mini-spec<br/>stands in for stages 2–4<br/>each skip recorded<br/>gate: phase-gate express (one task block, its fields and cases)<br/>verify: proof + QA battery (the qa_battery commands);<br/>the code review is optional, a skip is a decision entry<br/>a late risk tag or a failed assumption:<br/>back to Criteria, at standard depth"]
  G2 -. "small" .-> SMALL
  SMALL -.-> EXEC
  TRI -. "express" .-> EXP
  CLAR -. "rca: one known pattern" .-> EXP
  EXP -.-> T3

  %% ===================== STOPS =====================
  STOP[/"<b>stop and ask you</b><br/>in the main session · blocked beats guessed<br/>also at the token cap, or no progress: continue or stop?<br/>at a cap, first written down: deferred · follow-ups · decisions · assumptions"/]
  R2 -. "blockers left after 3 cycles" .-> STOP
  R3 -. "blockers left after 3 cycles" .-> STOP
  R4 -. "blockers left after 3 cycles" .-> STOP
  MRG -. "merge conflict, or a task<br/>failing after 3 fix cycles" .-> STOP
  FIX -. "still failing after 3 cycles" .-> STOP
  MRG -. "check fails:<br/>fix cycle 1 on sonnet<br/>cycles 2–3 on opus" .-> T1

  %% ===================== BACKWARD =====================
  R3 -. "criteria unbuildable" .-> CRIT
  FIX -. "you accept: a criterion must change" .-> CRIT
  FIX -. "you accept: a contract must change" .-> CON
  T1 -. "a test case is wrong (wrong-test)" .-> PLAN
  FIN -. "security blocker:<br/>Verify again, a fresh 3 cycles" .-> VER

  %% ===================== RUNTIME =====================
  subgraph RUN ["How it runs"]
    direction LR
    COND["<b>Conductor</b> · main session<br/>asks you · writes the files<br/>launches the fan-out workflows<br/>dispatches single reviewers"]
    AUTO["<b>Unattended</b><br/>/goal keeps it going<br/>a Stop-hook script decides done<br/>yields while a workflow runs<br/>caps on depth · tokens"]
    FILES["<b>State</b> · committed files<br/>README.md frontmatter · log.md<br/>shape.md · plan.md · retro.md<br/>commit hook: pd-lint --staged re-runs the earlier gates"]
    COND ~~~ AUTO ~~~ FILES
  end
  SHIP ~~~ RUN

  %% ===================== STYLE =====================
  classDef stage fill:#eef4fb,stroke:#3c6ea5,stroke-width:2px,color:#12263a
  classDef verify fill:#e6f0fa,stroke:#1f4e79,stroke-width:3px,color:#0d1f33
  classDef review fill:#fdf2e3,stroke:#c98a1b,stroke-width:2px,color:#4a3208
  classDef mech fill:#eaf6ec,stroke:#3f8c4f,stroke-width:2px,color:#123018
  classDef worker fill:#f4f1f8,stroke:#7a5fa3,stroke-width:1.5px,color:#2b1f3d
  classDef entry fill:#ffffff,stroke:#888,stroke-width:1.5px,color:#222
  classDef path fill:#ffffff,stroke:#888,stroke-width:1.5px,stroke-dasharray:5 4,color:#333
  classDef done fill:#3f8c4f,stroke:#2c6339,stroke-width:2px,color:#ffffff
  classDef stop fill:#fbeaea,stroke:#a8423f,stroke-width:2px,color:#3d1211
  classDef run fill:#f7f7f2,stroke:#777,stroke-width:1.5px,color:#222

  class CLAR,CRIT,CON,PLAN,FIN stage
  class QA verify
  class R2,R3,R4,REV review
  class TRI,G2,G3,G4,G5,G6,G7 mech
  class T1,T2,T3,MRG,FIX worker
  class IDEA,REQ,BUG entry
  class SMALL,EXP path
  class SHIP done
  class STOP stop
  class COND,AUTO,FILES run
